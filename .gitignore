# ==============================================================================
# GotchiLab_ Professional .gitignore
# ==============================================================================

# --- Operating System Files ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# --- IDE & Editors ---
.vscode/
**/.vscode/
.idea/
**/.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*.kate-swp

# --- PlatformIO & Embedded Toolchains ---
.pio/
**/.pio/
.pioenvs/
.piolibdeps/
.clangd/
compile_commands.json

# --- Python Environments & Caches ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Node / Web Dependency Caches ---
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
id_rsa
id_rsa.pub

# --- Firmware Binaries (Keep only Web Deployer matrix binaries) ---
*.bin
!web/binaries/*.bin
*.elf
*.hex

# --- Web Temporary / Backup Copies ---
web/index_*.html
*.tmp
*.bak
*.log
